{% # Added by OCS - TO get the current store language %}
{%- for language in localization.available_languages -%}
  {%- if language == localization.language %}
    {% assign store_selected_language = language.iso_code %}
  {% endif %}
{%- endfor -%}

<ul
  class="wt-page-nav-mega__list wt-page-nav-mega__list--center"
>
  {%- for link in section.settings.menu.links -%}
    {% assign menu_class = '--simple' %}
    {% assign show_mega = false %}
    {% assign promo_blocks = false %}

    {% if blocks.size > 0 %}
      {% for block in blocks %}
        {% assign megamenu_trigger = block.settings.title | handle | strip %}
        {% if link.handle == megamenu_trigger %}
          {% assign show_mega = true %}
          {% assign mega_block = block %}
          {% assign menu_class = '--mega' %}
          {% if mega_block.settings.desktop_image_1
            or mega_block.settings.desktop_image_2
            or mega_block.settings.desktop_image_3
            or mega_block.settings.desktop_image_4
            or mega_block.settings.desktop_image_5
            or mega_block.settings.desktop_image_6
          %}
            {% assign promo_blocks = true %}
          {% endif %}
        {% endif %}
      {% endfor %}
    {% endif %}

    {%- if link.links != blank or promo_blocks -%}
      <li
        class="wt-page-nav-mega__item wt-page-nav-mega__item--parent wt-page-nav-mega__item{{ menu_class }}"
        data-title="{{ link.title | escape }}"
        data-slider="slider{{ forloop.index0 }}"
      >
        <a
          href="{{ link.url }}"
          tabindex="-1"
          data-menu-level="1"
          class="wt-page-nav-mega__link wt-page-nav-mega__link--parent {% if link.current %} wt-page-nav-mega__link--active{% endif %}"
        >
          <span class="wt-page-nav-mega__link__text wt-page-nav-mega__link__text--underline">
            {{- link.title | escape -}}
          </span>
          {% render 'icons', id: 'plus' %}
          {% render 'icons', id: 'arrow-down' %}
        </a>
        <div class="wt-page-nav-mega__sublist__wrapper wt-page-nav-mega__sublist__wrapper{{ menu_class }}">
          <ul class="wt-page-nav-mega__sublist">
            {%- for childlink in link.links -%}
              {%- if childlink.links == blank -%}
                <li class="wt-page-nav-mega__sublist__item wt-page-nav-mega__sublist__item--child">
                  <a
                    href="{{ childlink.url }}"
                    data-menu-level="2"
                    tabindex="-1"
                    class="wt-page-nav-mega__sublist__link  {% if link.current %} wt-page-nav-mega__sublist__link--active{% endif %}"
                    ><span class="wt-page-nav-mega__decorated">{{ childlink.title | escape }}</span></a
                  >
                </li>
              {%- else -%}
                <li
                  class="wt-page-nav-mega__sublist__item wt-page-nav-mega__sublist__item--child wt-page-nav-mega__sublist--parent"
                >
                  <a
                    href="{{ link.url }}"
                    data-menu-level="2"
                    tabindex="-1"
                    class="wt-page-nav-mega__sublist__link wt-page-nav-mega__sublist__link--parent {% if link.current %} wt-page-nav-mega__sublist__link--active{% endif %}"
                  >
                    <span class="wt-page-nav-mega__decorated">{{ childlink.title | escape }} </span>
                    {% render 'icons', id: 'plus' %}
                    {% render 'icons', id: 'arrow-right' %}
                  </a>
                  <ul class="wt-page-nav-mega__sublist wt-page-nav-mega__sublist--nested">
                    {%- for grandchildlink in childlink.links -%}
                      <li
                        class="wt-page-nav-mega__sublist__item wt-page-nav-mega__sublist__item--grandchild"
                      >
                        <a
                          href="{{ grandchildlink.url }}"
                          data-menu-level="3"
                          class="wt-page-nav-mega__sublist__link"
                          tabindex="-1"
                        >
                          <span class="wt-page-nav-mega__decorated">{{ grandchildlink.title | escape }}</span>
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                </li>
              {%- endif -%}
            {%- endfor -%}
            {% if show_mega %}
              <li
                data-block-id="{{ mega_block.id }}"
                class="wt-page-nav-mega__sublist__item wt-page-nav-mega__sublist__item--gallery"
              >
                <ul class="mega-menu__gallery">
                  {% assign promo_images_count = 0 %}
                  {% for i in (1..6) %}
                    {% assign key = 'desktop_image_' | append: i %}
                    {% if mega_block.settings[key] %}
                      {% assign promo_images_count = promo_images_count | plus: 1 %}
                      <li class="mega-menu__gallery__item">
                        {% assign link_key = 'link_' | append: i %}
                        <a
                          href="{{ mega_block.settings[link_key] | downcase }}"
                          class="mega-menu__gallery__link"
                          data-menu-level="2"
                          tabindex="-1"
                        >
                          <picture class="mega-menu__gallery__picture">
                            <img
                              class="mega-menu__gallery__img"
                              srcset="
                                {% if mega_block.settings[key].width >= 400 %}{{ mega_block.settings[key] | image_url: width: 400 }} 400w, {% endif %}
                                {% if mega_block.settings[key].width >= 800 %}{{ mega_block.settings[key] | image_url: width: 800 }} 800w, {% endif %}
                                {% if mega_block.settings[key].width >= 1200 %}{{ mega_block.settings[key] | image_url: width: 1200 }} 1200w, {% endif %}
                                {% if mega_block.settings[key].width >= 1600 %}{{ mega_block.settings[key] | image_url: width: 1600 }} 1600w, {% endif %}
                                {{ mega_block.settings[key] | image_url: width: 800 }} 800w
                              "
                              sizes="(min-width: 800px) 800px, 100vw"
                              src="{{ mega_block.settings[key] | image_url: width: 800 }}"
                              alt="{{ mega_block.settings[key].alt | escape }}"
                              loading="lazy"
                              width="{{ mega_block.settings[key].width }}"
                              height="{{ mega_block.settings[key].height }}"
                            >
                            {% assign heading_key = 'heading_' | append: i %}
                            <span class="mega-menu__gallery__heading wt-page-nav-mega__decorated">
                              {{- mega_block.settings[heading_key] -}}
                            </span>
                            {% assign text_key = 'text_' | append: i %}
                            <p class="mega-menu__gallery__caption">{{ mega_block.settings[text_key] }}</p>
                          </picture>
                        </a>
                      </li>
                    {% endif %}
                  {% endfor %}
                </ul>
              </li>
              {% if promo_images_count > 0 %}
                <style>
                  [data-block-id='{{ mega_block.id }}'] {
                    --promo-columns: span {{mega_block.settings.promo_section_width}};
                  }
                </style>
              {% endif %}
            {% endif %}
          </ul>
        </div>
      </li>

    {%- else -%}
      <li
        class="wt-page-nav-mega__item"
        data-title="{{ link.title | escape }}"
        data-slider="slider{{ forloop.index0 }}"
      >
        <a
          href="{{ link.url }}"
          data-menu-level="1"
          tabindex="-1"
          class="wt-page-nav-mega__link {% if link.current %} wt-page-nav-mega__link--active{% endif %}"
          {% if link.current %}
            aria-current="page"
          {% endif %}
        >
          <span class="wt-page-nav-mega__link__text wt-page-nav-mega__link__text--underline">
            {{- link.title | escape -}}
          </span>
        </a>
      </li>
    {%- endif -%}
  {%- endfor -%}
</ul>

{% # Getting the hover image matching each menu item from "Menu hover image" blocks %}
<ul class="mega-menu-image-list">
  <li class="slider_initial active-slider">
    <img
      src="{{ section.settings.default_menu_image | image_url: width: 1200 }}"
      alt=""
      loading="lazy"
      width="{{ section.settings.default_menu_image.width }}"
      height="{{ section.settings.default_menu_image.height }}"
    >
  </li>
  {%- for link in section.settings.menu.links -%}
    {% assign link_handle = link.title | handle %}
    {% assign hover_image = blank %}

    {% for block in blocks %}
      {% if block.type == 'menu_hover_image' %}
        {% assign block_handle = block.settings.menu_item | handle %}
        {% if block_handle == link_handle %}
          {% if store_selected_language == 'fr' and block.settings.image_fr != blank %}
            {% assign hover_image = block.settings.image_fr %}
          {% elsif block.settings.image != blank %}
            {% assign hover_image = block.settings.image %}
          {% endif %}
        {% endif %}
      {% endif %}
    {% endfor %}

    {% assign menu_image = hover_image | default: section.settings.default_menu_image %}

    <li class="slider{{ forloop.index0 }} active-slider-previous">
      {% if menu_image %}
        <img
          src="{{ menu_image | image_url: width: 1200 }}"
          srcset="
            {{ menu_image | image_url: width: 600 }} 600w,
            {{ menu_image | image_url: width: 1200 }} 1200w,
            {{ menu_image | image_url: width: 1800 }} 1800w
          "
          sizes="50vw"
          alt="{{ link.title | escape }}"
          loading="lazy"
          width="{{ menu_image.width }}"
          height="{{ menu_image.height }}"
        >
      {% endif %}
    </li>
  {% endfor %}
</ul>

{% if request.design_mode %}
  {% # Editor-only diagnostics - never shown to customers on the live storefront %}
  {% assign menu_item_handles = '' %}
  {% assign missing_image_items = '' %}
  {% for link in section.settings.menu.links %}
    {% assign link_handle = link.title | handle %}
    {% assign menu_item_handles = menu_item_handles | append: link_handle | append: ',' %}
    {% assign has_match = false %}
    {% for block in blocks %}
      {% if block.type == 'menu_hover_image' %}
        {% assign block_handle = block.settings.menu_item | handle %}
        {% if block_handle == link_handle and block.settings.image != blank %}
          {% assign has_match = true %}
        {% endif %}
      {% endif %}
    {% endfor %}
    {% unless has_match %}
      {% assign missing_image_items = missing_image_items | append: link.title | append: ', ' %}
    {% endunless %}
  {% endfor %}
  {% assign missing_image_items = missing_image_items | strip_newlines %}

  {% assign orphaned_block_names = '' %}
  {% for block in blocks %}
    {% if block.type == 'menu_hover_image' and block.settings.menu_item != blank %}
      {% assign block_handle = block.settings.menu_item | handle %}
      {% unless menu_item_handles contains block_handle %}
        {% assign orphaned_block_names = orphaned_block_names | append: block.settings.menu_item | append: ', ' %}
      {% endunless %}
    {% endif %}
  {% endfor %}

  {% if missing_image_items != blank or orphaned_block_names != blank %}
    <div
      class="mega-menu-hover-image-warning"
      style="position:sticky; bottom:0; z-index:9999; background:#fff3cd; color:#664d03; border-top:2px solid #ffca2c; padding:10px 16px; font-size:12px; line-height:1.5; font-family:sans-serif;"
    >
      <strong>⚠ Menu hover images (editor preview only, not visible to customers):</strong>
      {% if missing_image_items != blank %}
        <div>
          No image set for: <strong>{{ missing_image_items | remove_last: ', ' }}</strong> — showing default image. Add
          a "Menu hover image" block with this exact name.
        </div>
      {% endif %}
      {% if orphaned_block_names != blank %}
        <div>
          These "Menu hover image" blocks don't match any current menu item (check spelling/renaming):
          <strong>{{ orphaned_block_names | remove_last: ', ' }}</strong>
        </div>
      {% endif %}
    </div>
  {% endif %}
{% endif %}
